# Copy to .env.production on the VPS and fill in. Never commit the real file.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Everything the application reads is documented in the repository root's
# .env.example; this file carries only what production sets differently.

APP_ENV=production

# --- Domains ---------------------------------------------------------------
# Both must already resolve to this VPS: Caddy answers the ACME challenge on
# port 80 and cannot prove a name that does not point here yet.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Vite inlines this into the bundle at BUILD time, so it is the URL the browser
# calls — it must match API_DOMAIN, and changing it needs an image rebuild:
#   docker compose -f docker-compose.prod.yml build frontend
VITE_API_BASE_URL=https://api.example.com

# --- Supabase --------------------------------------------------------------
# The application runs on the TRANSACTION pooler (6543): reachable over IPv4,
# and app/database/connection.py detects that port and disables psycopg's
# prepared statements, which transaction pooling cannot support.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Migrations and the SQLite->PostgreSQL copy use the SESSION pooler (5432).
# Both refuse to run over 6543 rather than risk a half-applied revision.
DIRECT_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Connection pool -------------------------------------------------------
# Supabase caps a project's client connections, so idle ones are spent budget.
# Size DB_POOL_SIZE against IMPORT_WORKER_COUNT: each import worker holds a
# connection for the whole of its import.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# PostgreSQL has real concurrent writers, unlike the SQLite this defaulted to 1
# for. Raise it only alongside DB_POOL_SIZE.
IMPORT_WORKER_COUNT=2

# --- Security --------------------------------------------------------------
# REQUIRED. Without it the API refuses to sign tokens in production. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later signs out every user; it does not invalidate any data.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# The X-User header is NOT authentication — anyone who can reach the API could
# claim any username. It must stay false here.
ALLOW_HEADER_AUTH=false

# Exactly the origin the browser app is served from. Never "*": the API sends
# credentials, and a wildcard with credentials is both refused by browsers and
# wrong.
CORS_ORIGINS=https://app.example.com

# --- Business configuration -------------------------------------------------
COMPANY_NAME=Example Industries Ltd.
CURRENCY_CODE=BDT
APP_VERSION=1.0.0
# 7 = July, giving "FY 2026-27". Never hard-coded anywhere in the code.
FINANCIAL_YEAR_START_MONTH=7

# --- Business map -----------------------------------------------------------
# The map runs on MapLibre GL JS over OpenFreeMap. Neither needs an API key, a
# token or a billing account, which is why there is nothing secret in this
# section. Business data is drawn from this application's own database; only the
# basemap tiles come from the provider named here.
#
# Override these to point at another provider. A value is either a MapLibre
# *style document* URL or a raster tile template with {z}/{x}/{y} in it — the
# application tells the two apart. Whatever the provider requires in the way of
# attribution stays on the map: MAP_ATTRIBUTION is added to the credit the
# style carries, never substituted for it.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# MAP_ATTRIBUTION=
# A satellite basemap is offered only when a provider is configured here. None
# ships by default.
# MAP_STYLE_URL_SATELLITE=
# MAP_ATTRIBUTION_SATELLITE=
# Where MapLibre fetches label glyphs. A style document names its own source;
# a raster tile template does not, and without one every point label and
# cluster count is silently dropped.
# MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# Where the map opens before any layer has answered: the centre of Bangladesh,
# zoomed to show the whole country. The map fits its data once it arrives.
MAP_DEFAULT_LATITUDE=23.685
MAP_DEFAULT_LONGITUDE=90.356
MAP_DEFAULT_ZOOM=6.5

# --- Optional integrations --------------------------------------------------
# Without a key the agent still answers and every number is identical — it falls
# back to its deterministic planner and formatter.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Leave unset and WhatsApp records what it WOULD have sent rather than
# pretending to send it, which is what keeps a dry run honest.
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
