# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Node -------------------------------------------------------------------
# frontend/.gitignore already ignores frontend/node_modules; a root-level
# install (npm run something from the repo root) puts a second tree here that
# rule cannot see, so ignore the directory by name at any depth.
node_modules/

# --- Secrets ----------------------------------------------------------------
# Every .env variant, not just `.env` — .env.bak carries the same JWT secret.
# .env.example is the committed template and is the one exception.
.env
.env.*
# The committed templates. `.env.*` above is deliberately broad — it has to
# catch .env.bak, which carries the same JWT secret as .env — so every template
# has to be named back in one at a time.
!.env.example
!.env.*.example

# --- Local databases --------------------------------------------------------
# `data/` holds ~3 GB of SQLite files: dev.db plus a pre-migration backup for
# each revision. The backups are named `dev.db.pre0024.bak`, so a bare `*.db`
# rule misses every one of them — match the stem instead. They hold real
# transactional data and must never leave this machine.
*.db
*.db-wal
*.db-shm
*.sqlite3
dev.db*
**/data/*.bak*
**/data/post-rollback-*/

# --- Business data ----------------------------------------------------------
# The source workbook and everything an operator has uploaded are real Naafco
# master and transaction data, not fixtures. The pipeline reads them from disk;
# it does not need them in version control. `data/uploads/` is the staging area
# `POST /api/data-upload/*` writes to.
# `**/` because there is a `data/` under both the repo root and `backend/`.
**/data/uploads/
**/data/transactions/
Master Data.xlsx
**/data/Master Data.xlsx
~$*.xlsx
# The rules above name the files that existed when they were written, and each
# new kind of extract has needed another one — the pg-*.dump.sql pair a schema
# copy left behind matched none of them. Nothing under `data/` has ever been
# tracked and nothing there belongs in version control: it is the source
# workbook, the SQLite databases, their per-migration backups, the upload
# staging area and now database dumps, all real Naafco data. Ignore the whole
# directory rather than chasing each new file type. `**/` because there is a
# `data/` under both the repo root and `backend/`.
**/data/

# --- Reference geography ----------------------------------------------------
# Admin boundaries are downloaded from GADM/HDX per README, never bundled —
# this directory alone is ~118 MB and one file in it exceeds GitHub's limit.
bgd_admin_boundaries.geojson/
*.geojson
# ...but frontend/public/geo/ holds the browser-sized derivatives the map
# actually draws — simplified and coordinate-rounded, 2.2 MB for the five that
# are shipped (country, divisions, districts, upazilas, sea mask). Vite copies
# them into dist/ and the browser fetches them directly, so without them every
# administrative layer 404s on a fresh clone. They cannot be regenerated on a
# host that lacks the ~118 MB source release above — nor, at present, on one
# that has it, since the generator was removed with the rest of the old map —
# which is why they are committed rather than built. manifest.json is committed
# with them and records where they came from.
!frontend/public/geo/
!frontend/public/geo/*.geojson

# --- Generated output -------------------------------------------------------
# Reproducible from the workbook via scripts/inspect_master_data.py; keep the
# directory so REPORTS_DIR resolves on a fresh clone.
reports/*
!reports/.gitkeep

# A screenshot of the running Business Map, exported by hand rather than built
# by anything here -- no script writes it, which is why it reappears after
# being deleted. The map is drawn at runtime from frontend/public/geo/ and the
# marker configuration the API serves, so a stale PNG of it documents nothing
# and goes out of date the moment a design or a boundary changes.
Business_Map.png

# --- Editor / local tooling -------------------------------------------------
# `.claude/` is Claude Code's state for this machine, not source: worktrees/
# holds entire checkouts of this repository, settings.local.json is one
# machine's permissions, and launch.json pins ports and a Windows interpreter
# path for one person's checkout. Ignoring the directory rather than naming
# files inside it is what stops a `git add -A` committing the repository into
# itself.
.claude/
.vscode/

# --- Local production deployment --------------------------------------------
# deploy/local/ holds the localhost stack. The launchers and the nginx config
# carry no secrets and are worth keeping, so this ignores only the two things
# that must not leave the machine plus the runtime it generates.
# (deploy/local/.env.production is already caught by the `.env.*` rule above.)
deploy/local/credentials.generated.txt
# The nginx distribution is copied in so the service has a path that does not
# change when nginx is upgraded — a binary, not source.
deploy/local/nginx/
deploy/local/run/
deploy/local/*.log
# NSSM is a third-party service manager downloaded onto the machine, not source
# for this project — the same reason nginx/ above is ignored. deploy/local/README.md
# says where to get it.
deploy/local/nssm.exe
# Timestamped backups the launchers leave beside a config. Git already holds the
# history of the file they back up.
deploy/local/*.bak-*

# --- Editor / vault artifacts -----------------------------------------------
# The repo doubles as an Obsidian vault on this machine. `.obsidian/` is that
# vault's own workspace state — pane layout, plugin toggles, graph settings —
# and `*.base` is a saved Obsidian base view. Neither describes the software.
.obsidian/
*.base
