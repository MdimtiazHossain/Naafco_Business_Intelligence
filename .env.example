# Copy to .env and adjust. Never commit the real .env.

APP_ENV=development

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_business_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Overrides the parts above when set (used by Alembic and every script).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_business_agent

# --- Master data ----------------------------------------------------------
MASTER_DATA_FILE=data/Master Data.xlsx
REPORTS_DIR=reports
TRANSACTIONS_DIR=data/transactions

# --- Financial year -------------------------------------------------------
# Month the financial year starts in (1-12). 7 = July, giving "FY 2026-27".
# Set to 1 for a calendar financial year, which is labelled "FY 2026".
FINANCIAL_YEAR_START_MONTH=7
FINANCIAL_YEAR_LABEL_PREFIX=FY

# --- ETL ------------------------------------------------------------------
# Rows per bulk insert / upsert statement.
ETL_BATCH_SIZE=5000
# Default source date format: auto | DD/MM/YYYY | MM/DD/YYYY | YYYY-MM-DD.
# "auto" accepts only unambiguous dates and rejects the rest rather than guessing.
DEFAULT_DATE_FORMAT=auto

# --- API ------------------------------------------------------------------
BACKEND_PORT=8000

# --- AI agent (Phase 3) ---------------------------------------------------
# Never commit a real key. Without one the agent still works: it falls back to
# its deterministic planner and formatter, and every number is unchanged.
# OPENAI_API_KEY=

# --- Business map -----------------------------------------------------------
# The map runs on MapLibre GL JS over OpenFreeMap. Neither needs an API key, a
# token or a billing account, which is why there is nothing secret in this
# section — the previous Google Maps browser key is gone along with the renderer
# that required it.
#
# Administrative boundaries are served with the frontend from
# frontend/public/geo/, generated by `python scripts/build_map_geojson.py`. They
# are not fetched from any external service at runtime.
#
# Override these only to point at your own tile server; the value must be a
# MapLibre *style document* URL, not a raster tile template.
# MAP_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# MAP_BASEMAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# Where the map opens before anything has coordinates. Defaults to Dhaka.
MAP_DEFAULT_LATITUDE=23.777
MAP_DEFAULT_LONGITUDE=90.399
MAP_DEFAULT_ZOOM=7
# Ceiling for uploaded marker artwork, in kilobytes.
MAP_MARKER_MAX_UPLOAD_KB=512sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

# --- Web platform (Phase 4) ------------------------------------------------
COMPANY_NAME=Example Industries Ltd.
CURRENCY_CODE=BDT
APP_VERSION=1.0.0

# Signing secret for access tokens. REQUIRED when APP_ENV=production — the API
# refuses to sign tokens with an ephemeral secret there. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# The Phase 3 X-User header is convenient behind a trusted gateway and in
# development, but it is NOT authentication. Leave it false in production.
ALLOW_HEADER_AUTH=true

# Origins the browser app is served from.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Where the browser should call the API. Vite inlines this at build time.
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=8080

# --- WhatsApp integration --------------------------------------------------
# Leave empty to run without a provider: the webhook still works and the agent
# still answers, but replies are recorded rather than sent.
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# Set an app secret to enforce the provider's payload signature.
# WHATSAPP_APP_SECRET=
# Require the provider's verified profile name to match the account on file.
WHATSAPP_REQUIRE_VERIFIED_PROFILE=false

# --- PDF export ------------------------------------------------------------
# Path to a TTF with Bengali coverage (e.g. NotoSansBengali-Regular.ttf).
# Without it, Bangla is transliterated in PDF; CSV and Excel are unaffected.
# PDF_BANGLA_FONT=
